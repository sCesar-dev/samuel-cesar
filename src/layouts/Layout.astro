---
import '../styles/global.css';
import HeaderNav from '../components/HeaderNav';
import Footer from '../components/Footer';
import { loadProfile } from '../lib/portfolioData';

const profile = await loadProfile();

const {
    title = profile.meta.title.pt,
    description = profile.meta.description.pt
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isHome = currentPath === baseUrl || currentPath === '' || currentPath === '/';
---
<!doctype html>
<html lang="pt-BR" data-theme="dark" class="scroll-smooth scroll-pt-20">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#09090b" id="meta-theme-color" />

        {/* Zero-Flash Theme & Locale Initialization Script (Runs synchronously before first paint) */}
        <script is:inline>
            (function() {
                try {
                    // 1. Theme resolution
                    var storedTheme = localStorage.getItem('scesar_theme');
                    var theme = 'dark';
                    if (storedTheme === 'light' || storedTheme === 'dark') {
                        theme = storedTheme;
                    } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                        theme = 'light';
                    }
                    document.documentElement.setAttribute('data-theme', theme);
                    document.documentElement.style.colorScheme = theme;

                    var metaTheme = document.getElementById('meta-theme-color');
                    if (metaTheme) {
                        metaTheme.setAttribute('content', theme === 'light' ? '#f8fafc' : '#09090b');
                    }

                    // 2. Locale resolution
                    var storedLocale = localStorage.getItem('scesar_locale');
                    var locale = 'pt-BR';
                    if (storedLocale === 'pt-BR' || storedLocale === 'en-US') {
                        locale = storedLocale;
                    } else {
                        var params = new URLSearchParams(window.location.search);
                        var urlLang = params.get('lang');
                        if (urlLang === 'pt' || urlLang === 'pt-BR') {
                            locale = 'pt-BR';
                        } else if (urlLang === 'en' || urlLang === 'en-US') {
                            locale = 'en-US';
                        } else {
                            var langs = navigator.languages || [navigator.language || ''];
                            for (var i = 0; i < langs.length; i++) {
                                var l = (langs[i] || '').toLowerCase();
                                if (l.startsWith('pt')) { locale = 'pt-BR'; break; }
                                if (l.startsWith('en')) { locale = 'en-US'; break; }
                            }
                        }
                    }
                    document.documentElement.setAttribute('lang', locale);
                    document.documentElement.setAttribute('data-locale', locale);
                } catch (e) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    document.documentElement.setAttribute('lang', 'pt-BR');
                }
            })();
        </script>
        
        {/* Fonts: Cabinet Grotesk & Satoshi (Fontshare), Fragment Mono (Google Fonts) */}
        <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
        <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@500,700,800,900&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono:ital@0;1&display=swap" rel="stylesheet" />

        {/* Open Graph / WhatsApp / LinkedIn */}
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={`${baseUrl}${profile.meta.ogImage}`} />
        
        {/* Favicon */}
        <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    </head>
    <body class="font-sans antialiased min-h-dvh flex flex-col items-center relative">
        {/* Accessibility Skip Link */}
        <a 
            id="skip-link"
            href="#main-content" 
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-4 py-2.5 rounded-lg bg-dominant text-on-dominant text-sm font-semibold shadow-xl border border-edge transition-transform"
        >
            Pular para o conteúdo principal
        </a>

        {/* Subtle Ambient Radial Lighting */}
        <div class="ambient-lighting fixed inset-0 z-[-2] h-full w-full pointer-events-none"></div>
        
        {/* Subtle Micro-texture Dot Pattern Overlay */}
        <div class="dot-texture-overlay fixed inset-0 z-[-1] h-full w-full pointer-events-none"></div>

        {/* Responsive Interactive Header */}
        <HeaderNav
            client:load
            baseUrl={baseUrl}
            isHome={isHome}
            brand={profile.brand}
            ownerName={profile.name}
            linkedInUrl={profile.contacts.linkedin}
        />

        {/* Main Content Area */}
        <main id="main-content" tabindex="-1" class="w-full max-w-6xl px-4 md:px-8 pt-20 pb-16 flex-1 focus:outline-none">
            <slot />
        </main>

        {/* Global Networking Footer */}
        <Footer
            client:load
            footerNotice={profile.location.footerNotice}
            githubUrl={profile.contacts.github}
            linkedInUrl={profile.contacts.linkedin}
            email={profile.contacts.email}
        />

        <style is:global>
            /* Progressive Scroll Reveal: visible by default so tall viewports never leave blank bands */
            .scroll-reveal {
                opacity: 1;
                transform: translateY(0);
                transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
            }
            .scroll-reveal.is-pending {
                transform: translateY(16px);
            }
            .scroll-reveal.is-visible {
                transform: translateY(0);
            }

            @media (prefers-reduced-motion: reduce) {
                .scroll-reveal,
                .scroll-reveal.is-pending {
                    opacity: 1 !important;
                    transform: none !important;
                    transition: none !important;
                }
            }
        </style>

        <script>
            import { listenToSystemThemeChanges } from '../lib/preferences';

            // Intersection observer on client side for subtle scroll motion without blanking sections
            document.addEventListener('DOMContentLoaded', () => {
                listenToSystemThemeChanges();

                // Update skip link text based on active locale
                const updateSkipLink = (locale) => {
                    const skipLink = document.getElementById('skip-link');
                    if (skipLink) {
                        skipLink.textContent = locale === 'en-US' 
                            ? 'Skip to main content' 
                            : 'Pular para o conteúdo principal';
                    }
                };

                const initialLocale = document.documentElement.getAttribute('data-locale') || 'pt-BR';
                updateSkipLink(initialLocale);

                window.addEventListener('scesar-locale-change', (e) => {
                    if (e.detail && e.detail.locale) {
                        updateSkipLink(e.detail.locale);
                    }
                });

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.remove('is-pending');
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    root: null,
                    rootMargin: '120px 0px',
                    threshold: 0.01
                });

                document.querySelectorAll('.scroll-reveal').forEach((el) => {
                    const rect = el.getBoundingClientRect();
                    if (rect.top > window.innerHeight) {
                        el.classList.add('is-pending');
                        observer.observe(el);
                    } else {
                        el.classList.add('is-visible');
                    }
                });
            });
        </script>
    </body>
</html>
