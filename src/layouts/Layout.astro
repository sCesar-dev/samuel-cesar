---
import '../styles/global.css';

const { title = "Samuel Cesar Portfolio" } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth scroll-pt-20">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
    </head>
    <body class="bg-zinc-950 text-white font-sans antialiased min-h-screen flex flex-col items-center">
        
        <header class="fixed top-0 left-0 w-full h-20 bg-zinc-950/95 border-b border-secondary z-50 flex items-center justify-center">
            <div class="w-full max-w-360 px-4 md:px-10 flex items-center justify-between">
                
                <button class="flex items-center">
                    <span class="text-neon-green text-xl font-bold tracking-tight">sCesar-dev</span>
                </button>
                
                <nav class="hidden md:flex gap-2">
                    <a href="#home" class="px-4 py-2 text-white font-semibold rounded-lg hover:bg-zinc-950/10 transition ">Home</a>
                    <a href="#about" class="px-4 py-2 text-white font-semibold rounded-lg hover:bg-zinc-950/10 transition">About</a>
                    <a href="#projects" class="px-4 py-2 text-white font-semibold rounded-lg hover:bg-zinc-950/10 transition">Projects</a>
                    <a href="#contact" class="px-4 py-2 text-white font-semibold rounded-lg hover:bg-zinc-950/10 transition">Contact</a>
                    <a href="#curriculum" class="px-4 py-2 text-white font-semibold rounded-lg hover:bg-zinc-950/10 transition">Curriculum</a>
                </nav>
            </div>
        </header>

        <main class="w-full max-w-360 px-4 md:px-10 pt-30 mt-20 pb-10">
            <slot />
        </main>
    </body>
</html>