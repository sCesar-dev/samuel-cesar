---
import '../styles/global.css';

const { 
    title = "Samuel Cesar | Engenharia de Dados, Ciência de Dados & Visão Computacional",
    description = "Portfólio de Samuel Cesar. Graduando em Sistemas de Informação (UNEB) em busca de estágio. Projetos em Engenharia de Dados, Ciência de Dados (Machine Learning), Visão Computacional e Nuvem AWS."
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isHome = currentPath === baseUrl || currentPath === '' || currentPath === '/';
const prefix = isHome ? '' : `${baseUrl}/`;
---
<!doctype html>
<html lang="pt-BR" class="scroll-smooth scroll-pt-20">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        <meta name="description" content={description} />
        
        {/* Google Fonts: Syne, IBM Plex Sans, JetBrains Mono */}
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" />
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Syne:wght@700;800;900&display=swap" rel="stylesheet" />

        {/* Open Graph / WhatsApp / LinkedIn */}
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={`${baseUrl}/images/robocup-image.jpg`} />
        
        {/* Favicon */}
        <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    </head>
    <body class="bg-[#09090b] text-white font-sans antialiased min-h-screen flex flex-col items-center relative selection:bg-cyan-400/25 selection:text-cyan-200">
        {/* Accessibility Skip Link */}
        <a 
            href="#main-content" 
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-[100] px-4 py-2.5 rounded-lg bg-cyan-400 text-zinc-950 font-mono text-xs font-bold shadow-xl border border-white/20 transition-transform"
        >
            Pular para o conteúdo principal
        </a>

        {/* Subtle Ambient Radial Lighting */}
        <div class="fixed inset-0 z-[-2] h-full w-full bg-[#09090b] bg-[radial-gradient(ellipse_80%_50%_at_50%_-15%,rgba(0,240,255,0.06),transparent)] pointer-events-none"></div>
        
        {/* Subtle Micro-texture Dot Pattern Overlay */}
        <div class="fixed inset-0 z-[-1] h-full w-full pointer-events-none opacity-[0.03] bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px]"></div>

        {/* Sticky Header */}
        <header class="fixed top-0 left-0 w-full h-16 md:h-18 bg-[#09090b]/85 backdrop-blur-xl border-b border-white/10 z-50 flex items-center justify-center">
            <div class="w-full max-w-6xl px-4 md:px-8 flex items-center justify-between">
                
                <a href={isHome ? "#home" : `${baseUrl}/`} aria-label="Samuel Cesar - Início" class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 rounded-lg p-1">
                    <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 group-hover:scale-125 transition-transform duration-300" aria-hidden="true"></span>
                    <span class="text-white text-base md:text-lg font-extrabold tracking-tight font-display group-hover:text-cyan-400 transition-colors">
                        sCesar<span class="text-cyan-400 font-mono text-sm">.dev</span>
                    </span>
                </a>
                
                <nav class="hidden md:flex gap-1 p-1 rounded-xl glass-panel" aria-label="Navegação principal">
                    <a href={`${prefix}#home`} class="px-3.5 py-1.5 text-zinc-300 text-xs font-medium transition-all rounded-lg hover:text-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400">Início</a>
                    <a href={`${prefix}#projects`} class="px-3.5 py-1.5 text-zinc-300 text-xs font-medium transition-all rounded-lg hover:text-cyan-400 hover:bg-cyan-400/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400">Projetos</a>
                    <a href={`${prefix}#about`} class="px-3.5 py-1.5 text-zinc-300 text-xs font-medium transition-all rounded-lg hover:text-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400">Sobre</a>
                    <a href={`${prefix}#curriculum`} class="px-3.5 py-1.5 text-zinc-300 text-xs font-medium transition-all rounded-lg hover:text-white hover:bg-white/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400">Currículo</a>
                    <a href={`${prefix}#contact`} class="px-3.5 py-1.5 text-emerald-400 text-xs font-semibold transition-all rounded-lg hover:text-emerald-300 hover:bg-emerald-400/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400">Contato</a>
                </nav>

                <div class="flex items-center gap-2">
                    <a 
                        href="https://www.linkedin.com/in/s-cesar/" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        aria-label="Abrir perfil de Samuel Cesar no LinkedIn"
                        class="px-3.5 py-1.5 rounded-lg bg-cyan-400/10 hover:bg-cyan-400/20 border border-cyan-400/30 text-cyan-300 text-xs font-mono font-semibold transition-all active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                    >
                        LinkedIn ↗
                    </a>
                </div>
            </div>
        </header>

        {/* Main Content Area */}
        <main id="main-content" tabindex="-1" class="w-full max-w-6xl px-4 md:px-8 pt-20 pb-16 flex-1 focus:outline-none">
            <slot />
        </main>

        {/* Global Networking Footer */}
        <footer class="w-full border-t border-white/10 bg-[#09090b]/90 backdrop-blur-lg py-8 text-center text-xs text-zinc-500 font-mono">
            <div class="max-w-6xl mx-auto px-4 md:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-2 text-zinc-400 text-left">
                    <span>Samuel Cesar • UNEB (Sistemas de Informação) • Salvador, BA</span>
                </div>
                <div class="flex items-center gap-4 text-zinc-400">
                    <a href="https://github.com/sCesar-dev" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
                    <span class="text-zinc-600">•</span>
                    <a href="https://www.linkedin.com/in/s-cesar/" target="_blank" rel="noopener noreferrer" class="hover:text-cyan-400 transition-colors">LinkedIn</a>
                    <span class="text-zinc-600">•</span>
                    <a href="mailto:samueljc003@gmail.com" class="hover:text-emerald-400 transition-colors">samueljc003@gmail.com</a>
                </div>
            </div>
        </footer>

        <style is:global>
            /* Scroll Reveal Classes */
            .scroll-reveal {
                opacity: 0;
                transform: translateY(24px);
                transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
                will-change: opacity, transform;
            }
            .scroll-reveal.is-visible {
                opacity: 1;
                transform: translateY(0);
            }

            @media (prefers-reduced-motion: reduce) {
                .scroll-reveal {
                    opacity: 1 !important;
                    transform: none !important;
                    transition: none !important;
                }
            }
        </style>

        <script>
            // Intersection observer on client side for smooth scroll animations
            document.addEventListener('DOMContentLoaded', () => {
                const observerOptions = {
                    root: null,
                    rootMargin: '0px',
                    threshold: 0.1
                };

                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, observerOptions);

                document.querySelectorAll('.scroll-reveal').forEach((el) => {
                    observer.observe(el);
                });
            });
        </script>
    </body>
</html>
