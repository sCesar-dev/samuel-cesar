---
import { FileText, Download, CheckCircle, GraduationCap, Award, Briefcase } from "lucide-react";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeUrl = `${baseUrl}/docs/Samuel_Cesar_Curriculum.pdf`;
---

<section id="curriculum" class="py-16 md:py-24 scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/10 pb-6">
        <div>
            <div class="flex items-center gap-2 text-emerald-400 font-mono text-xs uppercase tracking-wider mb-1 font-semibold">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                Currículo & Síntese
            </div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
                Síntese & Foco em Estágio
            </h2>
        </div>
        <div>
            <a
                href={resumeUrl}
                download="Samuel_Cesar_Curriculum.pdf"
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-sm shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all duration-200 active:scale-95"
            >
                <Download size={18} />
                <span>Baixar Currículo em PDF</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Card 1: Formação & Pesquisa */}
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2.5 text-cyan-400 mb-4">
                    <GraduationCap size={22} />
                    <h3 class="font-bold text-white text-base">Formação & Pesquisa</h3>
                </div>
                <div class="space-y-3 text-sm text-zinc-300">
                    <div>
                        <strong class="text-white block">Sistemas de Informação</strong>
                        <span class="text-xs text-zinc-400">Universidade do Estado da Bahia (UNEB) • Em andamento</span>
                    </div>
                    <div>
                        <strong class="text-white block">Pesquisa & Iniciação Científica</strong>
                        <span class="text-xs text-zinc-400">ACSO / BahiaRT • RoboCup@Home & CBR</span>
                    </div>
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 text-xs text-zinc-400 font-mono">
                Salvador, BA • Brasil
            </div>
        </div>

        {/* Card 2: Competências Principais */}
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2.5 text-emerald-400 mb-4">
                    <Briefcase size={22} />
                    <h3 class="font-bold text-white text-base">Competências Técnicas</h3>
                </div>
                <ul class="space-y-2 text-xs text-zinc-300">
                    <li class="flex items-start gap-2">
                        <CheckCircle size={14} className="text-emerald-400 shrink-0 mt-0.5" />
                        <span>Engenharia de Dados: Python, SQL, B-Trees & Grafos</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <CheckCircle size={14} className="text-purple-400 shrink-0 mt-0.5" />
                        <span>Ciência de Dados & ML: Scikit-Learn, Random Forest, EDA</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <CheckCircle size={14} className="text-cyan-400 shrink-0 mt-0.5" />
                        <span>Visão Computacional & Robótica: YOLOv8, Rekognition, ROS 2</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <CheckCircle size={14} className="text-amber-400 shrink-0 mt-0.5" />
                        <span>Cloud AWS: Lambda, S3, SAM (IaC), CloudWatch</span>
                    </li>
                </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 text-xs text-emerald-400 font-mono font-medium">
                Disponível para Estágio (Salvador / Remoto)
            </div>
        </div>

        {/* Card 3: Prêmios & Distinções */}
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between">
            <div>
                <div class="flex items-center gap-2.5 text-amber-400 mb-4">
                    <Award size={22} />
                    <h3 class="font-bold text-white text-base">Distinções Acadêmicas</h3>
                </div>
                <div class="space-y-3 text-xs text-zinc-300">
                    <div class="p-2.5 rounded-lg bg-zinc-950/40 border border-white/5">
                        <strong class="text-white block">1º Lugar — Hackathon LIAO / UFBA 2026</strong>
                        <span class="text-zinc-400">BioPoints: Modelagem Preditiva de CO₂ & Fidelidade</span>
                    </div>
                    <div class="p-2.5 rounded-lg bg-zinc-950/40 border border-white/5">
                        <strong class="text-white block">Competidor — CBR 2024 / 2025</strong>
                        <span class="text-zinc-400">Competição Brasileira de Robótica (BahiaRT / ACSO)</span>
                    </div>
                </div>
            </div>
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between">
                <span class="text-xs text-zinc-400 font-mono">Formato PDF A4</span>
                <a
                    href={resumeUrl}
                    download="Samuel_Cesar_Curriculum.pdf"
                    class="text-xs text-cyan-400 hover:text-cyan-300 font-medium inline-flex items-center gap-1"
                >
                    <Download size={13} />
                    <span>Baixar PDF</span>
                </a>
            </div>
        </div>
    </div>
</section>
