---
import { FileText, Download, CheckCircle2, GraduationCap, Award, Briefcase, MapPin } from "lucide-react";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const resumeUrl = `${baseUrl}/docs/Samuel_Cesar_Curriculum.pdf`;
---

<section id="curriculum" class="py-16 md:py-24 scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/10 pb-6">
        <div>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight font-display">
                Currículo &amp; Resumo Técnico
            </h2>
            <p class="text-zinc-400 text-sm md:text-base mt-2 max-w-xl font-light">
                Resumo técnico e acadêmico com disponibilidade imediata para estágio.
            </p>
        </div>
        <div>
            <a
                href={resumeUrl}
                download="Samuel_Cesar_Curriculum.pdf"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-mono font-bold text-xs uppercase tracking-wider transition-all duration-200 active:scale-[0.98] whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400"
            >
                <Download size={16} />
                <span>Baixar Currículo (PDF)</span>
            </a>
        </div>
    </div>

    {/* Asymmetric 2-Column Executive Summary Dashboard */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        {/* Left Column: Education & Fast Profile (5 cols) */}
        <div class="lg:col-span-5 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 flex flex-col justify-between backdrop-blur-xl space-y-6">
            <div>
                <div class="flex items-center gap-2.5 text-cyan-400 mb-5">
                    <GraduationCap size={22} />
                    <h3 class="font-bold text-white text-base md:text-lg font-display">Formação &amp; Pesquisa</h3>
                </div>
                
                <div class="space-y-4 text-sm text-zinc-300">
                    <div class="p-3.5 rounded-lg bg-white/[0.02] border border-white/5">
                        <span class="text-xs font-mono text-cyan-400 block mb-0.5">Graduação em Andamento</span>
                        <strong class="text-white block text-sm">Sistemas de Informação</strong>
                        <span class="text-xs text-zinc-400 font-light">Universidade do Estado da Bahia (UNEB) • Salvador, BA</span>
                    </div>

                    <div class="p-3.5 rounded-lg bg-white/[0.02] border border-white/5">
                        <span class="text-xs font-mono text-emerald-400 block mb-0.5">Iniciação Científica</span>
                        <strong class="text-white block text-sm">Laboratório ACSO / BahiaRT</strong>
                        <span class="text-xs text-zinc-400 font-light">Robótica Autônoma de Serviço (RoboCup@Home &amp; CBR)</span>
                    </div>
                </div>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-zinc-400">
                <span class="flex items-center gap-1.5">
                    <MapPin size={13} className="text-cyan-400" />
                    Salvador, BA (Presencial / Remoto)
                </span>
                <span class="text-emerald-400 font-semibold">Disponível para Estágio</span>
            </div>
        </div>

        {/* Right Column: Technical Competencies & Distinctions (7 cols) */}
        <div class="lg:col-span-7 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 backdrop-blur-xl flex flex-col justify-between space-y-6">
            <div>
                <div class="flex items-center gap-2.5 text-emerald-400 mb-5">
                    <Briefcase size={22} />
                    <h3 class="font-bold text-white text-base md:text-lg font-display">Competências &amp; Reconhecimentos</h3>
                </div>

                <div class="space-y-4">
                    {/* Competency Row 1 */}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                            <span class="text-[11px] font-mono text-cyan-400 uppercase font-semibold block mb-1">
                                Eng. de Dados &amp; Backend
                            </span>
                            <p class="text-xs text-zinc-300 font-light">
                                Python, SQL/PostgreSQL, indexação B-Tree O(log n), grafos e arquitetura orientada a dados.
                            </p>
                        </div>

                        <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                            <span class="text-[11px] font-mono text-emerald-400 uppercase font-semibold block mb-1">
                                Ciência de Dados &amp; ML
                            </span>
                            <p class="text-xs text-zinc-300 font-light">
                                Scikit-Learn, Random Forest, EDA, tratamento de features e modelagem preditiva aplicada.
                            </p>
                        </div>

                        <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                            <span class="text-[11px] font-mono text-cyan-400 uppercase font-semibold block mb-1">
                                Visão Computacional &amp; Robótica
                            </span>
                            <p class="text-xs text-zinc-300 font-light">
                                YOLOv8, Amazon Rekognition, ROS 2, C++ moderno e fusão sensorial de dados 3D.
                            </p>
                        </div>

                        <div class="p-3 rounded-lg bg-white/[0.02] border border-white/5">
                            <span class="text-[11px] font-mono text-emerald-400 uppercase font-semibold block mb-1">
                                Nuvem AWS &amp; DevOps
                            </span>
                            <p class="text-xs text-zinc-300 font-light">
                                Lambda serverless, S3, SAM CLI (IaC), CloudWatch, Docker e ambientes Linux.
                            </p>
                        </div>
                    </div>

                    {/* Academic Distinctions Strip */}
                    <div class="pt-3 border-t border-white/5">
                        <span class="text-[11px] font-mono uppercase tracking-wider text-zinc-400 font-semibold block mb-2">
                            Premiações &amp; Reconhecimento:
                        </span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                            <div class="p-2.5 rounded-lg bg-emerald-500/[0.04] border border-emerald-500/25 flex items-start gap-2">
                                <Award size={16} className="text-emerald-400 shrink-0 mt-0.5" />
                                <div>
                                    <strong class="text-xs text-white block">1º Lugar: Hackathon UFBA 2026</strong>
                                    <span class="text-[11px] text-zinc-400 font-light">BioPoints: Modelagem Preditiva de Fidelidade</span>
                                </div>
                            </div>

                            <div class="p-2.5 rounded-lg bg-white/[0.02] border border-white/10 flex items-start gap-2">
                                <Award size={16} className="text-cyan-400 shrink-0 mt-0.5" />
                                <div>
                                    <strong class="text-xs text-white block">Competidor: CBR 2024 / 2025</strong>
                                    <span class="text-[11px] text-zinc-400 font-light">Equipe BahiaRT / ACSO (RoboCup@Home)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs font-mono">
                <span class="text-zinc-500">Documento oficial atualizado em 2026</span>
                <a
                    href={resumeUrl}
                    download="Samuel_Cesar_Curriculum.pdf"
                    class="text-cyan-400 hover:text-cyan-300 font-medium inline-flex items-center gap-1.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400"
                >
                    <Download size={13} />
                    <span>Download Direto (PDF A4)</span>
                </a>
            </div>
        </div>

    </div>
</section>
