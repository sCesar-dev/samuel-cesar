---
import { CircleChevronLeft, CircleChevronRight, ImageIcon, Github, SquareArrowOutUpRight } from 'lucide-react';

import { getCollection } from 'astro:content';
const projects = await getCollection('projects');

const uniqueStacks = ["All", ...new Set(projects.map(p => p.data.stack))];
---

<section id="projects" class="pt-8 pb-128 w-full scroll-reveal">
    <div class="flex items-center gap-4 mb-8 pt-8">
        <h2 class="text-4xl md:text-4xl font-bold text-white tracking-tight">
            Featured Projects
        </h2>
        <div class="h-px flex-1 bg-forest-green/50"></div>
    </div>

    <div class="flex flex-wrap gap-3 mb-10 justify-center">
        {uniqueStacks.map((stack, index) => (
            <button 
                class={`filter-tab px-5 py-2 rounded-xl glass-button text-sm font-medium transition-all duration-300 ${index === 0 ? 'text-neon-green border-neon-green/80 shadow-[0_0_10px_rgba(57,255,20,0.2)]' : 'text-white/80 hover:text-neon-green hover:border-neon-green/50'}`}
                data-stack={stack}
            >
                {stack}
            </button>
        ))}
    </div>

    <div class="relative w-full max-w-5x1 mx-auto group">

         <button id="prev-btn" class="absolute left-0 md:-left-6 top-1/2 -translate-y-1/2 z-10 glass-button text-white hover:border-neon-green/80 hover:text-neon-green p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 disabled:opacity-30 disabled:border-white/10 disabled:text-white/50 disabled:cursor-not-allowed shadow-[0_0_15px_rgba(57,255,20,0.2)]">
            <CircleChevronLeft size={32} />
        </button>
        
        <div class="glass-card overflow-hidden rounded-2xl relative shadow-lg hover:-translate-y-2 hover:scale-[1.02] transition-all duration-300 ease-out group/card">
            <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out w-full">
                    
                {projects.map((project) => (
                    <div class="project-slide min-w-full flex flex-col md:flex-row h-auto md:h-100" data-stack={project.data.stack}>
                        
                        <div class="w-full md:w-1/2 bg-white/5 border-b md:border-b-0 md:border-r border-white/5 flex flex-col items-center justify-center text-white/50 group-hover/card:text-neon-green/80 group/img relative overflow-hidden transition-colors duration-500">
                            {project.data.images && project.data.images.length > 0 ? (
                                <img src={project.data.images[0]} alt={`Cover for project ${project.data.title}`} class="w-full h-full object-contain opacity-60 group-hover/card:opacity-100 transition-opacity duration-500" />
                            ) : (
                                <ImageIcon size={64} className="group-hover/img:scale-110 transition-transform duration-500" />
                            )}
                        </div>
    
                        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-between">
                            <div>
                                <h3 class="text-2xl font-bold text-text-color mb-4">{project.data.title}</h3>
                                <p class="text-silver bg-transparent leading-relaxed mb-8">
                                    {project.data.description}
                                </p>
                                
                                <div class="flex flex-wrap gap-2 mb-8">
                                    {project.data.techs.map((tech) => (
                                        <span class="px-3 py-1 rounded-md glass-button text-white text-sm font-medium">
                                            {tech}
                                        </span>
                                    ))}
                                </div>
                            </div>
    
                            <div class="flex items-center gap-4 mt-auto">
                                {project.data.github && project.data.github !== "#" && (
                                    <a href={project.data.github} target="_blank" class="flex items-center gap-2 text-white hover:text-neon-green transition-colors">
                                        <Github size={20} />
                                        <span class="font-medium">Code</span>
                                    </a>
                                )}
                                <a href={`/projects/${project.slug}`} class="flex items-center gap-2 text-white hover:text-neon-green transition-colors">
                                    <SquareArrowOutUpRight size={20} />
                                    <span class="font-medium">View Details</span>
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
                    
            </div>
        </div>

        <button id="next-btn" class="absolute right-0 md:-right-6 top-1/2 -translate-y-1/2 z-10 glass-button text-white hover:border-neon-green/80 hover:text-neon-green p-2 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 disabled:opacity-30 disabled:border-white/10 disabled:text-white/50 disabled:cursor-not-allowed shadow-[0_0_15px_rgba(57,255,20,0.2)]">
            <CircleChevronRight size={32} />
        </button>
    </div>

    <div class="flex justify-center gap-2 mt-6" id="indicator-container">
        {projects.map((_, index) => (
            <div class={`indicator w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'bg-neon-green scale-125' : 'bg-forest-green'}`} data-index={index}></div>
        ))}
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const track = document.getElementById('carousel-track');
        const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
        const indicatorContainer = document.getElementById('indicator-container');
        const filterTabs = document.querySelectorAll('.filter-tab');
        
        let allSlides = Array.from(document.querySelectorAll('.project-slide')) as HTMLElement[];
        let visibleSlides = [...allSlides];
        let currentIndex = 0;

        function updateIndicatorsDOM() {
            if (!indicatorContainer) return;
            indicatorContainer.innerHTML = '';
            visibleSlides.forEach((_, index) => {
                const dot = document.createElement('div');
                dot.className = `indicator w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'bg-neon-green scale-125' : 'bg-forest-green'}`;
                dot.dataset.index = index.toString();
                dot.addEventListener('click', () => {
                    currentIndex = index;
                    updateCarousel();
                });
                indicatorContainer.appendChild(dot);
            });
        }

        function updateCarousel() {
            if (track) {
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
            }

            const totalSlides = visibleSlides.length;
            if (prevBtn) prevBtn.disabled = currentIndex === 0 || totalSlides === 0;
            if (nextBtn) nextBtn.disabled = currentIndex === totalSlides - 1 || totalSlides === 0;

            const indicators = indicatorContainer?.querySelectorAll('.indicator') || [];
            indicators.forEach((ind, index) => {
                if (index === currentIndex) {
                    ind.classList.add('bg-neon-green', 'scale-125');
                    ind.classList.remove('bg-forest-green', 'scale-100');
                } else {
                    ind.classList.add('bg-forest-green', 'scale-100');
                    ind.classList.remove('bg-neon-green', 'scale-125');
                }
            });
        }

        function filterProjects(stack: string) {
            filterTabs.forEach(tab => {
                const htmlTab = tab as HTMLElement;
                if (htmlTab.dataset.stack === stack) {
                    htmlTab.classList.add('text-neon-green', 'border-neon-green/80', 'shadow-[0_0_10px_rgba(57,255,20,0.2)]');
                    htmlTab.classList.remove('text-white/80', 'hover:text-neon-green', 'hover:border-neon-green/50');
                } else {
                    htmlTab.classList.remove('text-neon-green', 'border-neon-green/80', 'shadow-[0_0_10px_rgba(57,255,20,0.2)]');
                    htmlTab.classList.add('text-white/80', 'hover:text-neon-green', 'hover:border-neon-green/50');
                }
            });

            visibleSlides = [];
            allSlides.forEach(slide => {
                if (stack === 'All' || slide.dataset.stack === stack) {
                    slide.style.display = '';
                    visibleSlides.push(slide);
                } else {
                    slide.style.display = 'none';
                }
            });

            currentIndex = 0;
            updateIndicatorsDOM();
            updateCarousel();
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                filterProjects((tab as HTMLElement).dataset.stack || 'All');
            });
        });

        prevBtn?.addEventListener('click', () => {
            if (currentIndex > 0) {
                currentIndex--;
                updateCarousel();
            }
        });

        nextBtn?.addEventListener('click', () => {
            if (currentIndex < visibleSlides.length - 1) {
                currentIndex++;
                updateCarousel();
            }
        });

        updateIndicatorsDOM();
        updateCarousel();
    });
</script>