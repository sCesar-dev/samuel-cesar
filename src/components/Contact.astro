---
import { Mail, Github, TerminalSquare } from 'lucide-react';
---

<section id="contact" class="pt-8 pb-128 w-full scroll-reveal">
    <div class="flex items-center gap-4 mb-12 pt-8">
        <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
            Get in <span class="text-neon-green">Touch</span>
        </h2>
        <div class="h-px flex-1 bg-forest-green/50"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="flex flex-col justify-center gap-6">

            <h3 class="text-1xl text-lg justify-center font-semibold mb-4 text-silver">
                If you have any questions, project ideas, or if you're a recruiter interested in my skills, feel free to contact me and let's talk!
            </h3>
            
            <div class="flex flex-col gap-4">
                <a href="mailto:samueljc003@gmail.com" class="flex items-center gap-4 p-4 rounded-xl glass-button text-white hover:border-neon-green hover:-translate-y-1 transition-all duration-300 group">
                    <div class="p-3 bg-zinc-950/50 backdrop-blur-md border border-white/5 rounded-lg text-white group-hover:text-neon-green group-hover:border-neon-green/50 transition-colors">
                        <Mail size={24} />
                    </div>
                    <div>
                        <p class="text-sm text-silver">Email</p>
                        <p class="text-white font-semibold">samueljc003@gmail.com</p>
                    </div>
                </a>

                <a href="https://github.com/sCesar-dev" target="_blank" class="flex items-center gap-4 p-4 rounded-xl glass-button text-white hover:border-neon-green hover:-translate-y-1 transition-all duration-300 group">
                    <div class="p-3 bg-zinc-950/50 backdrop-blur-md border border-white/5 rounded-lg text-white group-hover:text-neon-green group-hover:border-neon-green/50 transition-colors">
                        <Github size={24} />
                    </div>
                    <div>
                        <p class="text-sm text-silver">GitHub</p>
                        <p class="text-text-color font-semibold">github.com/sCesar-dev</p>
                    </div>
                </a>
            </div>
        </div>

        <div class="glass-card rounded-2xl p-8 flex flex-col items-center justify-center text-center gap-6 relative overflow-hidden h-full min-h-75 group">
            <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>
            <TerminalSquare size={48} className="text-white group-hover:text-neon-green transition-colors duration-300 relative z-10 drop-shadow-[0_0_8px_rgba(255,255,255,0.3)] group-hover:drop-shadow-[0_0_12px_rgba(57,255,20,0.6)]" />
            <h4 class="text-xl font-semibold text-text-color relative z-10 glow-text">Current Status</h4>
            <p class="text-text-secondary relative z-10 max-w-sm">
                Open to new opportunities, collaborations, and exciting challenges in software engineering and robotics.
            </p>
        </div>
    </div>
</section>