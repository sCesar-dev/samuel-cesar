---
import { Mail, Github, Linkedin, MessageCircle, QrCode } from 'lucide-react';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const qrCodeUrl = `${baseUrl}/qrcode.svg`;
const linkedInUrl = "https://www.linkedin.com/in/s-cesar/";
const githubUrl = "https://github.com/sCesar-dev";
const email = "samueljc003@gmail.com";
---

<section id="contact" class="py-16 md:py-24 w-full scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/10 pb-6">
        <div>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight font-display">
                Vamos Conversar?
            </h2>
            <p class="text-zinc-400 text-sm md:text-base mt-2 max-w-xl font-light">
                Aberto a propostas de estágio em Engenharia de Dados, Ciência de Dados, Visão Computacional ou Nuvem AWS.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        <div class="flex flex-col gap-3.5 justify-center">
            <a 
                href={linkedInUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-xl bg-[#121216]/80 border border-white/10 text-white hover:border-cyan-400/40 transition-all duration-200 active:scale-[0.98] group cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400"
            >
                <div class="p-3 bg-white/[0.03] border border-white/10 rounded-lg text-cyan-400 group-hover:bg-cyan-400/10 group-hover:border-cyan-400/30 transition-colors">
                    <Linkedin size={20} aria-hidden="true" />
                </div>
                <div>
                    <p class="text-[11px] text-zinc-400 font-mono uppercase tracking-wider">LinkedIn</p>
                    <p class="text-white font-semibold text-sm">Samuel Cesar</p>
                </div>
            </a>

            <a 
                href={githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-xl bg-[#121216]/80 border border-white/10 text-white hover:border-emerald-400/40 transition-all duration-200 active:scale-[0.98] group cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400"
            >
                <div class="p-3 bg-white/[0.03] border border-white/10 rounded-lg text-emerald-400 group-hover:bg-emerald-400/10 group-hover:border-emerald-400/30 transition-colors">
                    <Github size={20} aria-hidden="true" />
                </div>
                <div>
                    <p class="text-[11px] text-zinc-400 font-mono uppercase tracking-wider">GitHub</p>
                    <p class="text-white font-semibold text-sm">github.com/sCesar-dev</p>
                </div>
            </a>

            <a 
                href={`mailto:${email}`} 
                class="flex items-center gap-4 p-4 rounded-xl bg-[#121216]/80 border border-white/10 text-white hover:border-cyan-400/40 transition-all duration-200 active:scale-[0.98] group cursor-pointer focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400"
            >
                <div class="p-3 bg-white/[0.03] border border-white/10 rounded-lg text-cyan-400 group-hover:bg-cyan-400/10 group-hover:border-cyan-400/30 transition-colors">
                    <Mail size={20} aria-hidden="true" />
                </div>
                <div>
                    <p class="text-[11px] text-zinc-400 font-mono uppercase tracking-wider">Email Direto</p>
                    <p class="text-white font-semibold text-sm font-mono text-xs sm:text-sm">{email}</p>
                </div>
            </a>
        </div>

        <div class="rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 flex flex-col items-center justify-center text-center gap-4 backdrop-blur-xl">
            <div class="p-3 bg-white rounded-xl border border-white/20 transition-transform duration-300 hover:scale-[1.02]">
                <img 
                    src={qrCodeUrl} 
                    alt="QR Code do Portfólio de Samuel Cesar" 
                    width="144"
                    height="144"
                    class="w-32 h-32 md:w-36 md:h-36 object-contain" 
                />
            </div>

            <div>
                <h4 class="text-base md:text-lg font-bold text-white flex items-center justify-center gap-2 font-display">
                    <QrCode size={18} class="text-cyan-400" aria-hidden="true" />
                    <span>Acesso Instantâneo no Celular</span>
                </h4>
                <p class="text-zinc-400 text-xs md:text-sm mt-1 max-w-xs font-light">
                    Escaneie para abrir o portfólio e conectar diretamente pelo smartphone.
                </p>
            </div>

            <div class="pt-1">
                <a
                    href={linkedInUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-cyan-400 hover:bg-cyan-300 text-zinc-950 font-bold text-xs font-mono uppercase tracking-wider transition-all active:scale-[0.98] cursor-pointer whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                >
                    <MessageCircle size={14} aria-hidden="true" />
                    <span>Iniciar Conversa no LinkedIn</span>
                </a>
            </div>
        </div>
    </div>
</section>
