---
import { Mail, Github, Linkedin, MessageCircle, QrCode } from 'lucide-react';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const qrCodeUrl = `${baseUrl}/qrcode.svg`;
const linkedInUrl = "https://www.linkedin.com/in/s-cesar/";
const githubUrl = "https://github.com/sCesar-dev";
const email = "samueljc003@gmail.com";
---

<section id="contact" class="py-16 md:py-24 w-full scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 border-b border-white/10 pb-6">
        <div>
            <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs uppercase tracking-wider mb-1 font-semibold">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                Networking Presencial & Remoto
            </div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
                Vamos Conversar?
            </h2>
            <p class="text-zinc-400 text-sm md:text-base mt-1 max-w-xl font-light">
                Disponível para oportunidades de estágio em Engenharia de Dados, Backend, Cloud AWS, criação de interfaces e conexões estratégicas.
            </p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col gap-3.5 justify-center">
            <a 
                href={linkedInUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-xl glass-button text-white hover:border-cyan-400/50 hover:-translate-y-0.5 transition-all duration-200 group"
            >
                <div class="p-3 bg-zinc-950/60 border border-white/10 rounded-lg text-cyan-400 group-hover:bg-cyan-500/10 group-hover:border-cyan-500/40 transition-colors">
                    <Linkedin size={22} />
                </div>
                <div>
                    <p class="text-xs text-zinc-400 font-mono uppercase">LinkedIn</p>
                    <p class="text-white font-semibold text-sm">Samuel Cesar</p>
                </div>
            </a>

            <a 
                href={githubUrl} 
                target="_blank" 
                rel="noopener noreferrer"
                class="flex items-center gap-4 p-4 rounded-xl glass-button text-white hover:border-emerald-400/50 hover:-translate-y-0.5 transition-all duration-200 group"
            >
                <div class="p-3 bg-zinc-950/60 border border-white/10 rounded-lg text-emerald-400 group-hover:bg-emerald-500/10 group-hover:border-emerald-500/40 transition-colors">
                    <Github size={22} />
                </div>
                <div>
                    <p class="text-xs text-zinc-400 font-mono uppercase">GitHub</p>
                    <p class="text-white font-semibold text-sm">github.com/sCesar-dev</p>
                </div>
            </a>

            <a 
                href={`mailto:${email}`} 
                class="flex items-center gap-4 p-4 rounded-xl glass-button text-white hover:border-amber-400/50 hover:-translate-y-0.5 transition-all duration-200 group"
            >
                <div class="p-3 bg-zinc-950/60 border border-white/10 rounded-lg text-amber-400 group-hover:bg-amber-500/10 group-hover:border-amber-500/40 transition-colors">
                    <Mail size={22} />
                </div>
                <div>
                    <p class="text-xs text-zinc-400 font-mono uppercase">Email Direto</p>
                    <p class="text-white font-semibold text-sm">{email}</p>
                </div>
            </a>
        </div>

        <div class="glass-card rounded-2xl p-6 md:p-8 flex flex-col items-center justify-center text-center gap-4 relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-b from-cyan-500/5 to-transparent pointer-events-none"></div>
            
            <div class="p-3 bg-white rounded-2xl shadow-[0_0_25px_rgba(6,182,212,0.15)] border border-white/20 transition-transform hover:scale-105 duration-200">
                <img 
                    src={qrCodeUrl} 
                    alt="QR Code do Portfólio" 
                    class="w-32 h-32 md:w-36 md:h-36 object-contain" 
                />
            </div>

            <div>
                <h4 class="text-base md:text-lg font-bold text-white flex items-center justify-center gap-2">
                    <QrCode size={18} class="text-cyan-400" />
                    <span>Acesso Instantâneo no Celular</span>
                </h4>
                <p class="text-zinc-400 text-xs md:text-sm mt-1 max-w-xs font-light">
                    Escaneie para abrir o portfólio e salvar os contatos diretamente no smartphone.
                </p>
            </div>

            <div class="pt-1">
                <a
                    href={linkedInUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-zinc-950 font-bold text-xs transition-all shadow-[0_0_15px_rgba(6,182,212,0.3)] active:scale-95"
                >
                    <MessageCircle size={15} />
                    <span>Iniciar Conversa no LinkedIn</span>
                </a>
            </div>
        </div>
    </div>
</section>
