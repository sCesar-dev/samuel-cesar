---
import { CircleUserRound, Camera, CircleStar, CodeXml, Trophy } from 'lucide-react';

const profilePhoto = "/images/profile.jpg";

const eventPhotos = [
  {
    src: "/images/robocup-image.jpg",
    alt: "RoboCup Salvador 2025, Brasil",
    title: "RoboCup 2025 — Salvador",
    description: "Pesquisa acadêmica e integração no laboratório ACSO / BahiaRT (UNEB) para o Robô Bill."
  },
  {
    src: "/images/personal-image.jpg",
    alt: "CBR 2024 - Goiânia - Samuel Cesar",
    title: "CBR 2024 — Goiânia",
    description: "Competição Brasileira de Robótica universitária, validando sistemas autônomos e manipulação."
  },
  {
    src: "/images/robocup-image2.jpg",
    alt: "CBR 2025 & RoboCup 25 - Samuel Cesar",
    title: "Preparação Competitiva",
    description: "Calibração sensorial e otimização de nós de controle no laboratório universitário."
  }
];
---

<section id="about" class="py-16 md:py-24 flex flex-col gap-8 w-full scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
        <div>
            <div class="flex items-center gap-2 text-cyan-400 font-mono text-xs uppercase tracking-wider mb-1 font-semibold">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                Perfil & Trajetória
            </div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight">
                Sobre & Formação
            </h2>
        </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="md:col-span-2 glass-card rounded-2xl p-6 md:p-8 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4 text-cyan-400">
                <CircleUserRound size={26} />
                <h3 class="text-xl font-bold text-white">Objetivo: Oportunidade de Estágio</h3>
            </div>
            <p class="text-zinc-300 leading-relaxed text-base md:text-lg font-light">
                Graduando em Sistemas de Informação pela <strong class="text-white font-medium">Universidade do Estado da Bahia (UNEB)</strong>, estou ativamente em busca de <strong class="text-emerald-400 font-medium">oportunidades de estágio</strong> em Engenharia de Dados, Ciência de Dados (Machine Learning) ou Visão Computacional.
                <br><br>
                Desenvolvo projetos práticos unindo pipelines de dados e modelagem preditiva em Python (<strong class="text-purple-300 font-medium">Scikit-Learn, Random Forest, EDA</strong>), arquiteturas em nuvem com <strong class="text-cyan-300 font-medium">AWS (Lambda, S3, SAM)</strong> e estruturas de dados de alto desempenho (B-Trees, Grafos em Python/SQL). Fui vencedor do <strong class="text-white font-medium">1º Lugar no Hackathon da LIAO / UFBA 2026</strong> desenvolvendo a inteligência preditiva do <strong class="text-purple-300 font-medium">BioPoints</strong>. Minha bagagem conta também com sólida pesquisa acadêmica e iniciação científica no <strong class="text-white font-medium">ACSO / BahiaRT</strong> (UNEB), atuando em robótica de serviço (RoboCup@Home) com <span class="font-mono text-cyan-300 text-sm">ROS 2, YOLOv8 e C++</span>.
            </p>
        </div>

        <div class="glass-card rounded-2xl p-3 flex items-center justify-center min-h-[280px] md:min-h-full relative group overflow-hidden">
            {profilePhoto ? (
                <img 
                    src={profilePhoto} 
                    alt="Samuel Cesar" 
                    class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 rounded-xl" 
                />
            ) : (
                <div class="flex flex-col items-center gap-2 text-zinc-500">
                    <Camera size={36} />
                    <span class="text-xs font-mono">Foto de Perfil</span>
                </div>
            )}
        </div>

        {/* Highlights & Competitions */}
        <div class="col-span-1 md:col-span-3 glass-card rounded-2xl p-6 md:p-8">
            <div class="flex items-center gap-3 mb-6 text-amber-400">
                <Trophy size={26} />
                <h3 class="text-xl font-bold text-white">Conquistas & Reconhecimento Acadêmico</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col gap-2">
                    <span class="text-cyan-400 font-mono text-xs uppercase font-semibold">Pesquisa Acadêmica</span>
                    <h4 class="text-white font-semibold text-base">ACSO & BahiaRT (UNEB)</h4>
                    <p class="text-zinc-400 text-xs leading-relaxed">Iniciação científica e desenvolvimento de visão e manipulação para o Robô Bill na competição universitária RoboCup@Home.</p>
                </div>
                <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col gap-2">
                    <span class="text-amber-400 font-mono text-xs uppercase font-semibold">Competição Universitária</span>
                    <h4 class="text-white font-semibold text-base">CBR 2024 — Goiânia</h4>
                    <p class="text-zinc-400 text-xs leading-relaxed">Atuação na Competição Brasileira de Robótica com a equipe universitária BahiaRT / ACSO.</p>
                </div>
                <div class="p-4 rounded-xl bg-zinc-950/40 border border-white/5 flex flex-col gap-2">
                    <span class="text-purple-400 font-mono text-xs uppercase font-semibold">Premiação Hackathon</span>
                    <h4 class="text-white font-semibold text-base">1º Lugar — Hackathon LIAO / UFBA</h4>
                    <p class="text-zinc-400 text-xs leading-relaxed">Conquista do 1º lugar com o BioPoints na trilha de Inteligência Artificial, Cidades Inteligentes & Mudanças Climáticas.</p>
                </div>
            </div>
        </div>

        {/* Event Photos */}
        <div class="col-span-1 md:col-span-3 glass-card rounded-2xl p-6 md:p-8">
            <div class="flex items-center gap-3 mb-6 text-cyan-400">
                <Camera size={26} />
                <h3 class="text-xl font-bold text-white">Registros de Campo & Laboratório</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                {eventPhotos.map((photo) => (
                    <div class="bg-zinc-950/60 border border-white/10 rounded-xl overflow-hidden group/event hover:border-cyan-500/50 transition-all flex flex-col h-60 relative">
                        <img 
                            src={photo.src} 
                            alt={photo.alt} 
                            class="w-full h-full object-cover group-hover/event:scale-105 transition-transform duration-500" 
                        />
                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-zinc-950 via-zinc-950/90 to-transparent p-4 border-t border-white/5">
                            <h4 class="text-white font-semibold text-sm mb-1">{photo.title}</h4>
                            <p class="text-zinc-400 text-xs">{photo.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        {/* Stack */}
        <div class="col-span-1 md:col-span-3 glass-card rounded-2xl p-6 md:p-8">
            <div class="flex items-center gap-3 mb-4 text-emerald-400">
                <CodeXml size={24} />
                <h3 class="text-xl font-bold text-white">Core Technologies & Habilidades</h3>
            </div>
            
            <div class="flex flex-wrap gap-2.5">
                {[
                  'Ciência de Dados & ML',
                  'Scikit-Learn & Random Forest',
                  'Pandas & Feature Engineering',
                  'Análise Exploratória (EDA)',
                  'AWS (Lambda, S3, SAM)', 
                  'Python', 
                  'SQL & PostgreSQL', 
                  'Visão Computacional (YOLOv8)', 
                  'Estruturas de Dados & B-Trees', 
                  'Algoritmos de Grafos', 
                  'Docker & Linux', 
                  'ROS 2 (Pesquisa Acadêmica)', 
                  'C++ (Modern)',
                  'Figma & Assets SVG'
                ].map((skill) => (
                    <span class="px-3.5 py-1.5 rounded-lg bg-zinc-900/80 border border-white/10 text-zinc-200 text-xs font-mono hover:border-cyan-400/50 hover:text-white transition-colors cursor-default shadow-sm">
                        {skill}
                    </span>
                ))}
            </div>
        </div>
    </div>
</section>
