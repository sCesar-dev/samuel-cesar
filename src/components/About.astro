---
import { CircleUserRound, Camera, Trophy, CodeXml, Award, FlaskConical } from 'lucide-react';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const profilePhoto = `${baseUrl}/images/profile.jpg`;

const eventPhotos = [
  {
    src: `${baseUrl}/images/robocup-image.jpg`,
    alt: "RoboCup Salvador 2025, Brasil",
    title: "RoboCup 2025 - Salvador",
    description: "Pesquisa e integração de visão computacional e controle para o Robô Bill no ACSO / BahiaRT (UNEB).",
    span: "md:col-span-7"
  },
  {
    src: `${baseUrl}/images/personal-image.jpg`,
    alt: "CBR 2024 - Goiânia - Samuel Cesar",
    title: "CBR 2024 - Goiânia",
    description: "Validação experimental de sistemas autônomos na Competição Brasileira de Robótica.",
    span: "md:col-span-5"
  },
  {
    src: `${baseUrl}/images/robocup-image2.jpg`,
    alt: "CBR 2025 & RoboCup 25 - Samuel Cesar",
    title: "Preparação Competitiva",
    description: "Calibração de sensores e testes de nós de controle no laboratório universitário.",
    span: "md:col-span-12"
  }
];
---

<section id="about" class="py-16 md:py-24 flex flex-col gap-10 w-full scroll-mt-20 scroll-reveal">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-white/10 pb-6">
        <div>
            <h2 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight font-display">
                Sobre &amp; Formação
            </h2>
            <p class="text-zinc-400 text-sm md:text-base mt-2 max-w-xl font-light">
                Graduação na UNEB, iniciação científica em robótica e inteligência computacional.
            </p>
        </div>
    </div>
    
    {/* Asymmetric Bento: Bio (8 cols) + Photo (4 cols) */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        
        <div class="md:col-span-8 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 flex flex-col justify-center backdrop-blur-xl">
            <div class="flex items-center gap-2.5 mb-4 text-cyan-400">
                <CircleUserRound size={22} />
                <h3 class="text-lg font-bold text-white font-display">Objetivo: Oportunidade de Estágio</h3>
            </div>
            <div class="text-zinc-300 leading-relaxed text-sm md:text-base font-light space-y-4">
                <p>
                    Graduando em Sistemas de Informação pela <strong class="text-white font-medium">Universidade do Estado da Bahia (UNEB)</strong>, busco oportunidade de <strong class="text-emerald-400 font-medium">estágio</strong> em Engenharia de Dados, Ciência de Dados ou Visão Computacional.
                </p>
                <p>
                    Construo pipelines de dados, modelos preditivos em Python (<strong class="text-white font-medium">Scikit-Learn, Random Forest, Pandas</strong>), arquiteturas serverless na nuvem com <strong class="text-cyan-300 font-medium">AWS (Lambda, S3, SAM CLI)</strong> e estruturas de indexação de alto desempenho (B-Trees e Grafos).
                </p>
                <p>
                    Conquistei o <strong class="text-emerald-300 font-medium">1º Lugar no Hackathon LIAO / UFBA 2026</strong> desenvolvendo a inteligência de previsão e fidelidade do projeto BioPoints. Como bolsista de iniciação científica no <strong class="text-white font-medium">ACSO</strong> (UNEB), atuei durante 2 anos com robótica para robôs de serviço com <span class="font-mono text-cyan-300 text-xs bg-cyan-400/10 px-1.5 py-0.5 rounded border border-cyan-400/20">ROS 2, YOLOv8 e Python</span> e atualmente integro o <strong class="text-cyan-300 font-medium">ACSO DEFENSE</strong>, atuando em soluções para busca e reconhecimento utilizando drones autônomos.
                </p>
            </div>
        </div>

        <div class="md:col-span-4 rounded-xl bg-[#121216]/80 border border-white/10 p-2 flex items-center justify-center min-h-[300px] md:min-h-full relative group overflow-hidden">
            {profilePhoto ? (
                <img 
                    src={profilePhoto} 
                    alt="Samuel Cesar" 
                    class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500 rounded-lg" 
                />
            ) : (
                <div class="flex flex-col items-center gap-2 text-zinc-500">
                    <Camera size={36} />
                    <span class="text-xs font-mono">Foto de Perfil</span>
                </div>
            )}
        </div>

        {/* Asymmetric Recognition Banner: UFBA Hackathon Highlight + Research */}
        <div class="col-span-1 md:col-span-12 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 backdrop-blur-xl">
            <div class="flex items-center gap-2.5 mb-6 text-emerald-400">
                <Trophy size={22} />
                <h3 class="text-lg font-bold text-white font-display">Conquistas &amp; Reconhecimento</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
                {/* 1st Place Card - Primary Emphasis (6 cols) */}
                <div class="md:col-span-6 p-5 rounded-lg bg-emerald-500/[0.04] border border-emerald-500/30 flex flex-col justify-between">
                    <div>
                        <div className="flex items-center justify-between mb-2">
                            <span class="text-emerald-400 font-mono text-[11px] uppercase font-semibold">1º Lugar: Premiação Hackathon</span>
                            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">Vencedor</span>
                        </div>
                        <h4 class="text-white font-extrabold text-base font-display">Hackathon LIAO / UFBA 2026</h4>
                        <p class="text-zinc-400 text-xs leading-relaxed mt-1.5 font-light">
                            Desenvolvimento da inteligência preditiva do <strong class="text-zinc-200">BioPoints</strong> na trilha de Inteligência Artificial, Cidades Inteligentes & Mudanças Climáticas, utilizando Random Forest e simulação contrafactual.
                        </p>
                    </div>
                </div>

                {/* ACSO Lab Card (3 cols) */}
                <div class="md:col-span-3 p-5 rounded-lg bg-white/[0.02] border border-white/10 flex flex-col justify-between">
                    <div>
                        <span class="text-cyan-400 font-mono text-[11px] uppercase font-semibold block mb-2">Iniciação Científica</span>
                        <h4 class="text-white font-bold text-sm font-display">ACSO &amp; BahiaRT (UNEB)</h4>
                        <p class="text-zinc-400 text-xs leading-relaxed mt-1.5 font-light">
                            Pesquisa acadêmica e desenvolvimento de visão e manipulação para o Robô Bill na competição universitária RoboCup@Home.
                        </p>
                    </div>
                </div>

                {/* CBR 2024 Card (3 cols) */}
                <div class="md:col-span-3 p-5 rounded-lg bg-white/[0.02] border border-white/10 flex flex-col justify-between">
                    <div>
                        <span class="text-zinc-400 font-mono text-[11px] uppercase font-semibold block mb-2">Competição Nacional</span>
                        <h4 class="text-white font-bold text-sm font-display">CBR 2024 - Goiânia</h4>
                        <p class="text-zinc-400 text-xs leading-relaxed mt-1.5 font-light">
                            Atuação na Competição Brasileira de Robótica universitária com validação experimental de sistemas autônomos.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {/* Laboratory & Field Gallery - Asymmetric Layout */}
        <div class="col-span-1 md:col-span-12 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 backdrop-blur-xl">
            <div class="flex items-center gap-2.5 mb-6 text-cyan-400">
                <FlaskConical size={22} />
                <h3 class="text-lg font-bold text-white font-display">Registros de Campo &amp; Laboratório</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
                {eventPhotos.map((photo) => (
                    <div class={`${photo.span} bg-[#09090b] border border-white/10 rounded-xl overflow-hidden group/event hover:border-cyan-400/40 transition-all flex flex-col h-64 relative`}>
                        <img 
                            src={photo.src} 
                            alt={photo.alt} 
                            class="w-full h-full object-cover group-hover/event:scale-[1.03] transition-transform duration-500 opacity-90 group-hover/event:opacity-100" 
                        />
                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-[#09090b] via-[#09090b]/85 to-transparent p-4 border-t border-white/5">
                            <h4 class="text-white font-semibold text-sm mb-1">{photo.title}</h4>
                            <p class="text-zinc-400 text-xs font-light">{photo.description}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>

        {/* Categorized Skills Console */}
        <div class="col-span-1 md:col-span-12 rounded-xl bg-[#121216]/80 border border-white/10 p-6 md:p-8 backdrop-blur-xl">
            <div class="flex items-center gap-2.5 mb-5 text-emerald-400">
                <CodeXml size={22} />
                <h3 class="text-lg font-bold text-white font-display">Competências &amp; Domínios Técnicos</h3>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                <div>
                    <span class="text-[11px] font-mono uppercase font-semibold text-cyan-400 block mb-2.5">
                        Engenharia de Dados &amp; Nuvem
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                        {['Python', 'SQL & PostgreSQL', 'AWS (Lambda, S3, SAM)', 'B-Trees & Índices', 'Grafos & Dijkstra', 'Docker & Linux'].map((s) => (
                            <span class="px-2.5 py-1 rounded text-xs font-mono bg-white/[0.03] border border-white/10 text-zinc-300">
                                {s}
                            </span>
                        ))}
                    </div>
                </div>

                <div>
                    <span class="text-[11px] font-mono uppercase font-semibold text-emerald-400 block mb-2.5">
                        Ciência de Dados &amp; ML
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                        {['Scikit-Learn', 'Random Forest', 'Pandas & NumPy', 'Feature Engineering', 'Análise Exploratória (EDA)', 'Modelagem Preditiva'].map((s) => (
                            <span class="px-2.5 py-1 rounded text-xs font-mono bg-white/[0.03] border border-white/10 text-zinc-300">
                                {s}
                            </span>
                        ))}
                    </div>
                </div>

                <div>
                    <span class="text-[11px] font-mono uppercase font-semibold text-cyan-400 block mb-2.5">
                        Visão Computacional &amp; Robótica
                    </span>
                    <div class="flex flex-wrap gap-1.5">
                        {['YOLOv8', 'Amazon Rekognition', 'ROS 2 (RoboCup@Home)', 'C++ (Modern)', 'MoveIt 2', 'OpenCV'].map((s) => (
                            <span class="px-2.5 py-1 rounded text-xs font-mono bg-white/[0.03] border border-white/10 text-zinc-300">
                                {s}
                            </span>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
