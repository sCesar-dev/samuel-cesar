---
import Layout from '../layouts/Layout.astro';
import NotFoundContent from '../components/NotFoundContent';
import { loadProfile } from '../lib/portfolioData';
import { ptBR } from '../i18n/translations';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const profile = await loadProfile();
---

<Layout title={`${ptBR.notFound.metaTitle} | ${profile.name}`} description={ptBR.notFound.metaDescription}>
  <NotFoundContent client:load baseUrl={baseUrl} />
</Layout>
