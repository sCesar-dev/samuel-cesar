---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ImageCarousel from '../../components/ImageCarousel';
import ProjectDetailHeader from '../../components/ProjectDetailHeader';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title={`${entry.data.title} | Samuel Cesar`} description={entry.data.description}>
  <div class="w-full max-w-4xl mx-auto px-4 md:px-8 pt-8 pb-16">
    
    <ProjectDetailHeader 
      client:load
      slug={entry.slug}
      initialTitle={entry.data.title}
      initialDescription={entry.data.description}
      techs={entry.data.techs}
      github={entry.data.github}
      live={entry.data.live}
      baseUrl={baseUrl}
    />

    {entry.data.images && entry.data.images.length > 0 && (
      <section class="mb-14">
        <ImageCarousel client:visible images={entry.data.images} altPrefix={entry.data.title} />
      </section>
    )}

    {entry.data.videos && entry.data.videos.length > 0 && (
      <section class="mb-14">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {entry.data.videos.map((vid, index) => {
            const videoUrl = vid.startsWith('http') ? vid : `${baseUrl}${vid.startsWith('/') ? '' : '/'}${vid}`;
            return (
              <div class={`rounded-xl overflow-hidden border border-white/10 bg-[#121216]/80 ${index === 0 && (!entry.data.images || entry.data.images.length === 0) ? 'md:col-span-2' : ''}`}>
                <video src={videoUrl} autoplay loop muted playsinline class="w-full h-auto object-cover hover:scale-[1.01] transition-transform duration-500"></video>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <article class="project-content">
      <Content />
    </article>
    
  </div>
</Layout>

<script>
  const resolveMediaUrls = () => {
    const article = document.querySelector('.project-content');
    if (!article) return;

    const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
    article.querySelectorAll('a, img, video').forEach((el) => {
      if (el instanceof HTMLAnchorElement) {
        const href = el.getAttribute('href');
        if (href && href.startsWith('/') && !href.startsWith(baseUrl)) {
          el.setAttribute('href', `${baseUrl}${href}`);
        }
      } else if (el instanceof HTMLImageElement || el instanceof HTMLVideoElement) {
        const src = el.getAttribute('src');
        if (src && src.startsWith('/') && !src.startsWith(baseUrl)) {
          el.setAttribute('src', `${baseUrl}${src}`);
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', resolveMediaUrls);
  } else {
    resolveMediaUrls();
  }
</script>
