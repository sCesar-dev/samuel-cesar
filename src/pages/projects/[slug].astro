---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, Github, SquareArrowOutUpRight } from 'lucide-react';
import ImageCarousel from '../../components/ImageCarousel';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | Samuel César`} description={entry.data.description}>
  <main class="min-h-screen bg-bg-color text-text-color font-sans pt-24 pb-12">
    <div class="max-w-4xl mx-auto px-6 md:px-12">
      
      <a href="/#projects" class="inline-flex items-center gap-2 text-silver hover:text-neon-green transition-colors mb-8 group">
        <ArrowLeft size={20} class="group-hover:-translate-x-1 transition-transform" />
        <span>Back to Projects</span>
      </a>

      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">{entry.data.title}</h1>
        <p class="text-xl text-silver mb-6">{entry.data.description}</p>
        
        <div class="flex flex-wrap gap-2 mb-8">
          {entry.data.techs.map((tech) => (
            <span class="px-3 py-1 rounded-md glass-button text-white text-sm font-medium">
              {tech}
            </span>
          ))}
        </div>

        <div class="flex items-center gap-6">
          {entry.data.github && entry.data.github !== "#" && (
            <a href={entry.data.github} target="_blank" class="flex items-center gap-2 text-white hover:text-neon-green transition-colors">
                <Github size={20} />
                <span class="font-medium">View Code</span>
            </a>
          )}
          {entry.data.live && entry.data.live !== "#" && (
            <a href={entry.data.live} target="_blank" class="flex items-center gap-2 text-white hover:text-neon-green transition-colors">
                <SquareArrowOutUpRight size={20} />
                <span class="font-medium">Live Demo</span>
            </a>
          )}
        </div>
      </header>

      {entry.data.images && entry.data.images.length > 0 && (
        <section class="mb-16">
          <ImageCarousel client:load images={entry.data.images} altPrefix={entry.data.title} />
        </section>
      )}

      {entry.data.videos && entry.data.videos.length > 0 && (
        <section class="mb-16">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {entry.data.videos.map((vid, index) => (
              <div class={`rounded-xl overflow-hidden glass-card shadow-lg ${index === 0 && (!entry.data.images || entry.data.images.length === 0) ? 'md:col-span-2' : ''}`}>
                <video src={vid} autoplay loop muted playsinline class="w-full h-auto object-cover hover:scale-[1.02] transition-transform duration-500"></video>
              </div>
            ))}
          </div>
        </section>
      )}

      <article class="project-content">
        <Content />
      </article>
      
    </div>
  </main>
</Layout>

<script>
  const setupLayout = () => {
    const article = document.querySelector('.project-content');
    if (!article) return;

    const children = Array.from(article.children);
    let currentSection: HTMLDivElement | null = null;
    let hasReachedFirstH2 = false;
    let introSection: HTMLDivElement | null = null;

    children.forEach((child) => {
      // Hide the redundant first H1 (the title of the page is already in the header)
      if (child.tagName === 'H1') {
        child.remove();
        return;
      }

      // If we find an H2, we create a new card container
      if (child.tagName === 'H2') {
        hasReachedFirstH2 = true;
        currentSection = document.createElement('div');
        currentSection.className = 'bg-zinc-900/30 backdrop-blur-lg border border-white/5 p-6 md:p-8 rounded-xl shadow-[0_8px_32px_rgba(0,0,0,0.4)] mb-8 hover:border-white/10 transition-all duration-300';
        article.appendChild(currentSection);
      }

      // Move element to its appropriate section
      if (hasReachedFirstH2) {
        if (currentSection) {
          currentSection.appendChild(child);
        }
      } else {
        if (!introSection) {
          introSection = document.createElement('div');
          introSection.className = 'mb-10 text-lg leading-relaxed text-silver border-b border-white/5 pb-8';
          article.appendChild(introSection);
        }
        introSection.appendChild(child);
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupLayout);
  } else {
    setupLayout();
  }
</script>
